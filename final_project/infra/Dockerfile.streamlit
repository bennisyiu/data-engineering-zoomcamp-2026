# Text-to-SQL UI; connects to warehouse service on the Compose network
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY infra/streamlit-requirements.txt /app/
RUN pip install --no-cache-dir -r streamlit-requirements.txt

COPY streamlit_app /app/streamlit_app

# Railway supplies PORT; Docker Compose falls back to 8501.
CMD ["sh", "-c", "streamlit run streamlit_app/app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true"]
